@startuml adventureworld_core
' Class diagram for AdventureWorld coursework

title AdventureWorld Core Modules
skinparam dpi 400
skinparam shadowing false
skinparam minClassWidth 140
skinparam roundCorner 12

package "CLI" {
    class CLIManager {
        +parse_arguments()
    }
}

package "Configuration" {
    class ConfigLoader {
        +load_from_args(args)
    }
}

package "Simulation" {
    class SimulationEngine {
        -config
        -current_step
        +run(interactive)
        +step()
    }

    class Terrain {
        -grid
        +is_free_point(pos)
        +random_free_point()
    }

    class Patron {
        -state
        -patience
        +step_change(tick, rides)
    }

    class Ride {
        -state
        -queue
        +tick()
    }

    class FerrisWheel
    class PirateShip
    class SpinnerRide
}

package "Stats" {
    class ExportManager {
        +write_kpi_csv(path, timeline)
    }
}

package "Behaviors" {
    class MovementBehavior {
        +step_towards(pos, target, speed, terrain)
    }
    class DecisionBehavior {
        +compute_ride_score(pos, ride, terrain, prefs)
    }
    class QueueBehavior {
        +process_queue_patience(patron, current_time, rides)
    }
}

CLIManager --> ConfigLoader : builds
ConfigLoader --> SimulationEngine : provides config
SimulationEngine --> Terrain : initialises
SimulationEngine --> Patron : updates
SimulationEngine --> Ride : updates
SimulationEngine ..> ExportManager : writes KPIs
Ride <|-- FerrisWheel
Ride <|-- PirateShip
Ride <|-- SpinnerRide

Patron --> Terrain : queries paths
Patron --> Ride : joins queues
Patron ..> MovementBehavior
Patron ..> DecisionBehavior
Patron ..> QueueBehavior
Ride --> Terrain : checks capacity zones

@enduml
